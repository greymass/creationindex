# creationindex configuration

# Storage
db-path = ./creationindex.db

# HTTP API ('none' to disable)
http-listen = :9480
# http-socket = ./creationindex.sock

# Data source
actionstream-source = stream://localhost:9081

# Gift program account (gift.vaulta on Vaulta, gift.gm on Jungle 4)
program-account = gift.vaulta

# Logging
# log-filter = startup,sync,status
# log-file = ./creationindex.log

# Debug
# debug = false
